<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_background"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar_surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/chat_background"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/safety_teal" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/chat_background"
                android:paddingEnd="8dp"
                app:navigationIcon="@drawable/ic_menu"
                app:subtitleTextAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- One continuous ChatGPT-style conversation canvas. -->
            <LinearLayout
                android:id="@+id/chat_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/chat_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tv_chat_model_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/chat_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_knowledge_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/chat_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/chat_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/conversation_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_chip_orange"
                                    android:gravity="center"
                                    android:text="O₂"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_answer"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_answer"
                                    android:lineSpacingExtra="3dp"
                                    android:padding="14dp"
                                    android:text="안녕하세요. 밀폐공간 안전작업 가이드와 점검표를 근거로 답변합니다.\n\n무엇을 확인해 드릴까요?"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quick_prompt_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="자주 묻는 안전 확인"
                                android:textColor="@color/chat_muted"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_quick_air"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="start|center_vertical"
                                android:minHeight="48dp"
                                android:text="작업 전 공기 측정 기준"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                app:cornerRadius="14dp"
                                app:strokeColor="@color/chat_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_quick_rescue"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="start|center_vertical"
                                android:minHeight="48dp"
                                android:text="작업자 쓰러짐 · 구조 절차"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                app:cornerRadius="14dp"
                                app:strokeColor="@color/chat_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_quick_permit"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="start|center_vertical"
                                android:minHeight="48dp"
                                android:text="작업허가 전 안전조치"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                app:cornerRadius="14dp"
                                app:strokeColor="@color/chat_border" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/chat_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="＋"
                            android:textColor="@color/chat_muted"
                            android:textSize="25sp" />

                        <EditText
                            android:id="@+id/et_question"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="안전 작업에 대해 물어보세요"
                            android:imeOptions="actionSend"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="5"
                            android:minHeight="46dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/chat_muted"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_voice"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="음성으로 질문하기. 길게 누르면 오투야 호출 대기"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="◉"
                            android:textColor="@color/chat_primary"
                            android:textSize="20sp"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ask"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="질문 보내기"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="↑"
                            android:textSize="21sp"
                            app:backgroundTint="@color/chat_primary"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scroll_latest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:minHeight="36dp"
                    android:text="↓ 최근 답변으로"
                    android:textColor="@color/chat_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/chat_border" />
            </LinearLayout>

            <!-- Model catalogue and inference values. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/settings_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/chat_background"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="온디바이스 모델"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="다운로드가 완료되면 인터넷 없이 답변합니다."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/chat_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Gemma 4 E2B Instruct"
                                        android:textColor="@color/text_primary"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="LiteRT-LM · 약 2.4 GB · RAM 6 GB 이상 권장"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_model_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_chip_warm"
                                    android:paddingStart="10dp"
                                    android:paddingTop="5dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="5dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_model_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <ProgressBar
                                android:id="@+id/progress_model"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="12dp"
                                android:max="100"
                                android:progressTint="@color/chat_primary"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_model_action"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="16dp"
                                android:text="앱에서 다운로드"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/chat_primary"
                                app:cornerRadius="12dp" />

                            <TextView
                                android:id="@+id/tv_device_profile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="추론 설정"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/chat_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="실행 백엔드"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_backend"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="2dp"
                                android:backgroundTint="@color/chat_primary" />

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/chat_border" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="총 컨텍스트 한도" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="기기 메모리에 맞춘 안전 범위" android:textColor="@color/text_secondary" android:textSize="12sp" />
                                </LinearLayout>
                                <TextView android:id="@+id/tv_context_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chat_primary" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_context"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                app:haloColor="@color/chat_primary_soft"
                                app:thumbColor="@color/chat_primary"
                                app:trackColorActive="@color/chat_primary"
                                app:trackColorInactive="@color/chat_border" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="응답 예산 목표" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="총 컨텍스트 안에서 자동 상한 조정" android:textColor="@color/text_secondary" android:textSize="12sp" />
                                </LinearLayout>
                                <TextView android:id="@+id/tv_response_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chat_primary" android:textSize="16sp" android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_response"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                app:haloColor="@color/chat_primary_soft"
                                app:thumbColor="@color/chat_primary"
                                app:trackColorActive="@color/chat_primary"
                                app:trackColorInactive="@color/chat_border" />

                            <TextView
                                android:id="@+id/tv_settings_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/runtime_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/chat_primary"
                        app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이 기기의 실행 상태" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_runtime_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_settings"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:text="추론 설정 저장"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/chat_primary"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Bluetooth sensor setup is separate from model controls. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/sensor_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/chat_background"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="센서 연결 상태" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Bluetooth LE 가스 검출기의 실제 측정값만 표시합니다." android:textColor="@color/text_secondary" android:textSize="14sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/sensor_surface"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:id="@+id/tv_gas_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/sensor_muted" android:textSize="13sp" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O₂" android:textColor="@color/sensor_muted" android:textSize="13sp" />
                                    <TextView android:id="@+id/tv_oxygen_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="monospace" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H₂S" android:textColor="@color/sensor_muted" android:textSize="13sp" />
                                    <TextView android:id="@+id/tv_h2s_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="monospace" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CO" android:textColor="@color/sensor_muted" android:textSize="13sp" />
                                    <TextView android:id="@+id/tv_co_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="monospace" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEL" android:textColor="@color/sensor_muted" android:textSize="13sp" />
                                    <TextView android:id="@+id/tv_lel_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="monospace" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/chat_border"
                        app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="가스 검출기 연결" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_bluetooth_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_bluetooth_scan" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="주변 가스 검출기 검색" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/chat_primary" app:cornerRadius="12dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_bluetooth_disconnect" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="연결 해제" android:textColor="@color/text_primary" android:visibility="gone" app:cornerRadius="12dp" app:strokeColor="@color/chat_border" />
                            <LinearLayout android:id="@+id/bluetooth_device_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="측정기 제조사별 서비스 UUID와 패킷 형식이 다를 수 있습니다. 현재는 JSON, key=value, CSV 형식의 알림 값을 안전하게 검증합니다." android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Navigation and local chat history. -->
    <LinearLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="48dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_chip_orange" android:gravity="center" android:text="O₂" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="HYBRIDTECH" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_chat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:gravity="start|center_vertical"
            android:text="＋  새 대화"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/chat_border" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_nav_chat" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:gravity="start|center_vertical" android:text="문서 채팅" android:textColor="@color/text_primary" android:textSize="14sp" app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_nav_sensor" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="start|center_vertical" android:text="센서 연결 상태" android:textColor="@color/text_primary" android:textSize="14sp" app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_nav_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="start|center_vertical" android:text="설정" android:textColor="@color/text_primary" android:textSize="14sp" app:cornerRadius="12dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingStart="10dp" android:text="채팅 기록" android:textColor="@color/chat_muted" android:textSize="12sp" android:textStyle="bold" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/chat_history_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:text="DEVICE ONLY · 기기 내 AI" android:textColor="@color/chat_muted" android:textSize="11sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
