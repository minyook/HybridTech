<!-- 소스 안내
Activity의 기본 Android 테마. Compose 내부 테마 정의와 적용 위치를 구분한다.
-->
<resources>
    <!-- Framework window theme; the visible app theme is supplied by Compose. -->
    <style name="Base.Theme.Sllm2" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/safety_teal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface_warm</item>
        <item name="android:navigationBarColor">@color/surface_warm</item>
    </style>

    <style name="Theme.Sllm2" parent="Base.Theme.Sllm2" />
</resources>
