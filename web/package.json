{
  "name": "field-guard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:semantic": "node ../tools/prepare-semantic.mjs && node scripts/build-semantic-index.mjs",
    "prepare:assets": "npm run prepare:semantic && node scripts/prepare-assets.mjs && node scripts/build-ai-worker.mjs && node scripts/prepare-voice.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prepare:assets && tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preiphone:test": "npm run build",
    "iphone:test": "node scripts/iphone-test.mjs",
    "supervisor": "node server/manage.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate:150": "node scripts/evaluate-150.mjs",
    "evaluate:focused": "node scripts/evaluate-focused.mjs",
    "evaluate:semantic": "node scripts/evaluate-semantic.mjs",
    "package:knowledge": "node scripts/package-knowledge.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@litert-lm/core": "0.18.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@noble/hashes": "2.0.1",
    "idb": "8.0.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "fake-indexeddb": "6.2.4",
    "onnxruntime-node": "1.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
